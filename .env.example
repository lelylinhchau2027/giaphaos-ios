# URL bản web đã deploy (UI app = trang này)
EXPO_PUBLIC_WEB_URL=https://giapha-os.homielab.com

# Tên hiển thị
EXPO_PUBLIC_SITE_NAME=Gia Phả OS

# Supabase — lấy từ project Supabase > Settings > API
# Dùng để widget + thông báo sinh nhật/giỗ (không cần login)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Bundle ID iOS (đổi nếu muốn)
IOS_BUNDLE_ID=com.giaphaos.family

# App Group (phải khớp entitlements widget)
EXPO_PUBLIC_APP_GROUP=group.com.giaphaos.family

# Apple Team ID (Developer account → Membership) — khuyến nghị cho widget build
# IOS_APPLE_TEAM_ID=XXXXXXXXXX

# Sau khi `eas init`
# EAS_PROJECT_ID=
# EAS_OWNER=
